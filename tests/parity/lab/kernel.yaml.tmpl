# A kernel of the parity lab (lab.sh writes it from this template). Same settings as
# deploy/kernel/config.example.yaml, except: the model endpoint (@UPSTREAM@ = the bench's meter
# for the kernel under test, the scripted endpoint for the conformance kernel) and the code root
# (the bench's work folder, mounted at the same path in the kernel and for the bench).
pg_dsn_env: NOKKER_PG_DSN
memory_mcp_url: ""
api_keys: []
telegram_ids: {}
extra_go_senders: [local-owner]
tiers:
  ship:
    base_url: @UPSTREAM@
    model: @MODEL@
    api_key_env: SOKKAN_KERNEL_MODEL_KEY
    cache: prefix
  deep:
    base_url: @UPSTREAM@
    model: @MODEL@
    api_key_env: SOKKAN_KERNEL_MODEL_KEY
    cache: prefix
route:
  policy: v0
  classifier: rules
  code_to_deep: false
judge_enabled: false
judge_review: false
web_search_enabled: false
context_enabled: @CONTEXT@
context_corthexis:
  enabled: false
  root_dir: /opt/data/session-memory
previews_cache_dir: /opt/data/previews
guide: false
approvals_enabled: true
bubbles_enabled: true
host_clarify_options: true
host_session_budget: true
host_reasoning_stream: true
host: @HOST@
port: @PORT@
local:
  reasoning: false
  state_dir: /opt/data
  token_path: /run/kernel/local-token
  settings_path: /opt/data/settings.json
  allowed_hosts_env: NOKKER_ALLOWED_HOSTS
  max_calls: @MAX_CALLS@
  # host-embed flags of the kernel (its docs/HOST-EMBED.md; all off by default there), set as
  # SOKKAN will ship them: PARITY_HOST_EMBED=1 (default). memory_direct stays OFF: a note of a
  # conversation goes through SOKKAN's own MCP `memory_write` (quarantine), the kernel's
  # `memory_note` is removed from the cockpit's sessions by `deny_tools` (the adapter).
  surfaces_gate: @HOST_EMBED@
  strict_resume: @HOST_EMBED@
  mcp_session_headers: @HOST_EMBED@
  conclude_on_green: @HOST_EMBED@
  chain_max_calls: @CHAIN_MAX@
  memory_direct: false
  code:
    roots: [@ROOT@]
    backend: @SANDBOX@
    # docker: the model's commands run in a sandbox container, never in the kernel's; the
    # work folder is mounted at the same path in the kernel, so the daemon sees it there too
    require_sandbox: @REQUIRE_SANDBOX@
    image: @SANDBOX_IMAGE@
    host_roots: {"@ROOT@": "@ROOT@"}
