# /etc/sokkan/ship.env — the local model of the appliance (deploy/appliance/ship/docker-compose.yml)
SHIP_IMAGE=sokkan-ship:0.32.0
SHIP_MODELS_DIR=/srv/models/hf
SHIP_MODEL_DIR=qwen3.8-27b-int4
SHIP_MODEL_NAME=qwen3.8-27b
SHIP_PORT=8004
# cards (Level Zero ids) and tensor parallel size — 4× Arc Pro B60
SHIP_CARDS=0,1,2,3
SHIP_TP=4
SHIP_CTX=131072
SHIP_SEQS=32
# share of each card's memory given to the model + cache. 0.80 leaves room for the memory
# embedding and reranker on one card; raise only after measuring.
SHIP_UTIL=0.80
SHIP_MEM=26g
SHIP_CPUS=12
