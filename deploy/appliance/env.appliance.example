# ── SOKKAN on-prem appliance — .env of the box ────────────────────────────────────────
# Written by `install.sh --profile appliance` (values in <…> are asked or generated). One
# machine serves the cockpit, the memory (CortHeXis) and the everyday model; only the
# hard requests leave it, for the Deep gateway. Reference of every variable:
# docs/ENVIRONMENT.md · the profile explained: docs/appliance/README.md ·
# what each line changes, and how to see it: tests/e2e_appliance/README.md (T14).

# ---- release: pinned, never « latest » -------------------------------------------------
# <version>+<commit>, written by the installer and by scripts/upgrade.sh. /api/version must
# answer exactly this.
SOKKAN_VERSION=<version+commit>
SOKKAN_COMMIT=<commit>
# prebuilt, signed images (no build on the box); a release without a valid signature is refused
SOKKAN_IMAGES=1
SOKKAN_IMAGE_TAG=<version-commit>
SOKKAN_REQUIRE_SIGNATURE=1
COMPOSE_FILE=docker-compose.yml:docker/compose.images.yml
COMPOSE_PATH_SEPARATOR=:
# appliance = the local router + HTTPS on the LAN ; rerank = the memory reranker
COMPOSE_PROFILES=appliance,rerank

# ---- who ----------------------------------------------------------------------------
SOKKAN_ORG_NAME=<organisation>
SOKKAN_OWNER_EMAIL=<admin e-mail>
SOKKAN_OWNER_NAME=<admin name>
# the OWNER's access code (generated). Every other person gets a personal code:
# scripts/appliance/accounts.sh add <e-mail> --name … --project …
SOKKAN_LOCAL_TOKEN=<generated>
SOKKAN_AUTH_MODE=local
# a signed-in person the instance does not list sees nothing but their own project(s)
SOKKAN_DEFAULT_ROLE=none
SOKKAN_FEATURE_MULTI_PROJECT=1
SOKKAN_TZ=Europe/Zurich
SOKKAN_ERROR_LANG=fr

# ---- network: HTTPS on the LAN, nothing in clear on the network -----------------------
# the plain-HTTP port answers on the machine itself only; people use https://<name>
SOKKAN_BIND=127.0.0.1
SOKKAN_PORT=3009
SOKKAN_TLS_SITES=https://<box name>, https://<box IP>
SOKKAN_PUBLIC_URL=https://<box name>

# ---- inference: the model of the machine, Deep through the gateway ---------------------
# Ship = the model served on this box (vLLM, deploy/appliance/ship). Sessions use it without
# any click in the cockpit.
SOKKAN_SHIP_URL=http://host.docker.internal:8004
SOKKAN_SHIP_MODEL=qwen3.8-27b
# Deep = the operator gateway; the token is this instance's (quota and credit are per token)
SOKKAN_DEEP_URL=https://infer.sokkan.ch
SOKKAN_DEEP_TOKEN=<instance token>
SOKKAN_DEEP_MODEL=sokkan-deep
# 1 = hard requests go to Deep (keyword /deep, repeated tool failures); 0 = only when asked
SOKKAN_ESCALATION=1
# 1 = when the local model is down, answer from Deep instead of failing (uses credit)
SOKKAN_SHIP_FALLBACK_DEEP=1
# Nina (the in-app assistant) answers from the local model too (OpenAI door)
SOKKAN_FEATURE_ASSISTANT=1
SOKKAN_ASSISTANT_LLM_URL=http://host.docker.internal:8004/v1
SOKKAN_ASSISTANT_LLM_MODEL=qwen3.8-27b
SOKKAN_ASSISTANT_LLM_API=openai
SOKKAN_ASSISTANT_LLM_TOKEN=local

# « Write with Claude » (docs/appliance/README.md): a person may choose, when sending a work of a
# project classified public or team, to have it written by Claude with the organisation's
# Anthropic key (entered by an administrator in Settings, never here). Confidential projects
# never. The router reads the right and the key from the api with this secret (generated).
SOKKAN_FEATURE_CLAUDE_TIER=1
SOKKAN_ROUTER_SECRET=<generated>
SOKKAN_CLAUDE_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5,claude-fable-5-2
SOKKAN_CLAUDE_MODEL=claude-opus-5-5
SOKKAN_CLAUDE_MAX_LEVEL=team

# sessions on a model served by vLLM: the CLI's default reasoning effort is refused (HTTP 400
# « Unexpected reasoning effort high ») — medium is what the local model accepts
CLAUDE_CODE_EFFORT_LEVEL=medium

# ---- the cockpit of the people who work here (pilot: simple profile, study, ingestion) ---
# document drop + the simple profile (it requires the drop); everybody starts in the simple
# profile, a person switches to the technical one in their settings (SOKKAN_PROFILE_LOCKED=1
# reserves that choice to an administrator)
SOKKAN_FEATURE_DOCUMENTS=1
SOKKAN_FEATURE_SIMPLE_PROFILE=1
SOKKAN_PROFILE_DEFAULT=simple
# study mode: inert until a study is active — read from the Deep gateway (GET /usage with the
# instance token), or declared here with SOKKAN_STUDY_ID. docs/enterprise/STUDY-MODE.md
SOKKAN_FEATURE_STUDY_MODE=1
# « Export our work »: an administrator downloads what the organisation built (notes, agents,
# skills, deliverables — no secret) as one zip. docs/enterprise/OPERATIONS.md
SOKKAN_FEATURE_WORK_EXPORT=1
# document ingestion (requires the agents and the memory quarantine, both on): the documents
# are read by the LOCAL model only, 4 streams; nothing is read until a source is declared in
# /data/doc-ingest/sources.json. docs/enterprise/DOC-INGEST.md
SOKKAN_FEATURE_DOC_INGEST=1
SOKKAN_DOC_INGEST_LLM_URL=http://host.docker.internal:8004/v1
SOKKAN_DOC_INGEST_LLM_MODEL=qwen3.8-27b
SOKKAN_DOC_INGEST_CONCURRENCY=4

# ---- memory: Postgres + embedding and reranker served by this machine's GPU -----------
SOKKAN_DB_PASSWORD=<generated>
CORTHEXIS_MEMORY_BACKEND=postgres
SOKKAN_MEMORY_PROFILE=gpu
# cpu | sycl (Intel Arc). With sycl the installer adds docker/embed/compose.sycl.yml to
# COMPOSE_FILE (scripts/memory-setup.sh).
SOKKAN_EMBED_ACCEL=sycl
# the Gemma Terms of Use are the CLIENT's decision: 1 = accepted (EmbeddingGemma), 0 = declined
# (MIT model). The installer asks; nothing is downloaded before an answer.
SOKKAN_ACCEPT_GEMMA_TERMS=<0|1>

# ---- screens this public does not need ------------------------------------------------
SOKKAN_FEATURE_TMUX=0
SOKKAN_FEATURE_PREVIEW=0
SOKKAN_FEATURE_MAGNITUDE=0
SOKKAN_FEATURE_MISSIONS_LINK=0
# no Prometheus / Grafana / Loki here: the Operate plane has no source and stays hidden
SOKKAN_FEATURE_ALERTING=0
SOKKAN_FEATURE_AGENT_INCIDENTS=0
# updates are applied by the operator with signed releases, not announced to the users
SOKKAN_UPDATE_CHECK=0

# ---- supervision and support (docs/appliance/HEARTBEAT.md, SUPPORT-TUNNEL.md) ----------
# heartbeat: version, health, backup age, disk, memory review score — no client content.
# Empty URL = nothing is ever sent.
SOKKAN_HEARTBEAT_URL=<https://… or empty>
SOKKAN_HEARTBEAT_TOKEN=<token or empty>
SOKKAN_HEARTBEAT_INTERVAL_S=900
SOKKAN_INSTANCE_ID=<opaque name, e.g. pilot-a>
# longest opening of the support tunnel a person can ask for, in hours
SOKKAN_SUPPORT_MAX_HOURS=4
