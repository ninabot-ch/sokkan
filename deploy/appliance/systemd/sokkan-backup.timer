[Unit]
Description=SOKKAN appliance — nightly encrypted off-site backup

[Timer]
# every night between 01:30 and 02:30 local time; a box that was off at that time catches up
# at the next start (Persistent)
OnCalendar=*-*-* 01:30:00
RandomizedDelaySec=3600
Persistent=true

[Install]
WantedBy=timers.target
