[Unit]
Description=SOKKAN support tunnel: a reboot always closes the tunnel
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/sokkan/appliance.env
ExecStart=/opt/sokkan/scripts/appliance/support-tunnel.sh close --by system:boot
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
